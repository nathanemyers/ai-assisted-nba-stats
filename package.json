{
  "name": "ai-assisted-nba-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox: a local LLM (via Ollama) that reasons over a local NBA stats SQLite database using tool calling.",
  "scripts": {
    "postinstall": "node scripts/ensure-db.mjs",
    "start": "tsx src/client/cli.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "build-db": "python3 build_db.py",
    "scrapeNBA": "tsx tools/nba-power-rankings-scraper/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^11.3.0",
    "ollama": "^0.5.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
